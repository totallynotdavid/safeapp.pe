APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The local MariaDB instance scripts/db.sh runs, which reads these same values.
# "localhost" would resolve to the system's default socket, so keep 127.0.0.1.
# `make setup` fills DB_PASSWORD with a random value when it creates .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u667897538_safeapp_sistem
DB_USERNAME=safeapp
DB_PASSWORD=

# The scratch database holding the restored pre-rewrite production export, read
# by `php artisan cutover:transform`. Only needed while the cutover is pending;
# `make cutover FILE=<dump.sql>` creates it on the dev server. In production,
# restore the export into it yourself. Credentials fall back to the DB_* ones
# above.
LEGACY_DB_DATABASE=safeapp_legacy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production transactional email through Resend. Keep `log` locally; set these
# only after the sender domain is verified in Resend.
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_MAILER=resend
# MAIL_FROM_ADDRESS="notificaciones@example.com"

VITE_APP_NAME="${APP_NAME}"
