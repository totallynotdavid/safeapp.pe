# mysqli's literal "localhost" resolves to the system's default socket, not
# the project-local MariaDB instance started by scripts/db.sh. Keep 127.0.0.1.
DB_HOST=127.0.0.1
# Default matches the Hostinger account name baked into 127_0_0_1.sql. Rename
# freely: scripts/db.sh creates this database and ignores the dump's own name.
DB_NAME=u667897538_safeapp_sistem
DB_USER=
DB_PASS=
